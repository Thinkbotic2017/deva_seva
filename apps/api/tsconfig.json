{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    // TypeORM assigns entity properties via reflection decorators, not constructors.
    // Disabling only this one check; all other strict checks remain enforced.
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "rootDir": "./src",
    "baseUrl": "./",
    "paths": {
      "@devaseva/types": ["../../packages/types/src"],
      "@devaseva/types/*": ["../../packages/types/src/*"]
    },
    "incremental": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
